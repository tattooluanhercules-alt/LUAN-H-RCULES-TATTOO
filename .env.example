# APP_URL: URL base da aplicação (ex: https://seu-estudio.vercel.app)
APP_URL="https://luanhtattoo.vercel.app"

# Integração Google OAuth 2.0 / Drive / Sheets (preencher apenas em Secrets / Environment Variables no servidor)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://luanhtattoo.vercel.app/api/google/callback"
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_SHEET_ID=""

# Administração e Segurança de Sessão
ADMIN_EMAIL=""
SESSION_SECRET=""

# Limite máximo de upload em MB (padrão: 25)
MAX_UPLOAD_MB="25"
